{
  "name": "flutvier-pollservice",
  "version": "0.1.0",
  "description": "FlutVier PollService — optional companion server for bandwidth persistence and server-side polling.",
  "type": "module",
  "main": "../dist/pollservice/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "cp package.json ../dist/pollservice/package.json && cp -r drizzle ../dist/pollservice/drizzle",
    "start": "node ../dist/pollservice/index.js",
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
