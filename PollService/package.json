{
  "name": "flutvier-pollservice",
  "version": "0.1.0",
  "description": "FlutVier PollService — optional companion server for bandwidth persistence and server-side polling.",
  "type": "module",
  "main": "../dist/pollservice/index.js",
  "scripts": {
    "build": "tsc",
    "postbuild": "mkdir -p ../dist/pollservice/scripts && cp package.json ../dist/pollservice/package.json && cp scripts/install.sh ../dist/pollservice/scripts/install.sh",
    "start": "node ../dist/pollservice/index.js",
    "dev": "NODE_ENV=development tsx watch src/index.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "morgan": "^1.10.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
